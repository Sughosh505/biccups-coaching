# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# seeded design canvas (2.5MB build artifact — rebuilt from the .dc.html sources)
docs/frontend/canvas/coach-screens.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI scratch
supabase/.temp
scratch/

# Real client data. Spreadsheets exported from the coach's Drive hold named
# people's health information and must never reach the repo, which is public on
# GitHub. Keep them outside the working tree or under scratch/.
*.xlsx
*.xls
client-data/
